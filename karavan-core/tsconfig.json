{
  "ts-node": {
    "transpileOnly": true,
    "esm": true
  },
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "outDir": "./lib",
    "rootDir": "./src",
    "strict": true,
    "lib": [
      "dom",
      "dom.iterable",
      "esnext",
      "ES2021",
      "ES2021.String"
    ],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node", "mocha", "chai"]
  },
  "tsc-alias": {
    "resolveFullPaths": true,
    "verbose": false
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules"
  ]
}