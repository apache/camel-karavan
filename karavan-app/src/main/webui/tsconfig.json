{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strictNullChecks": false,
    "noFallthroughCasesInSwitch": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "vite-plugin-svgr/client"],
    "paths": {
      "@core/*": ["./src/core/*"],
      "@api/*": ["./src/api/*"],
      "@bus/*": ["./src/bus/*"],
      "@models/*": ["./src/models/*"],
      "@services/*": ["./src/services/*"],
      "@stores/*": ["./src/stores/*"],

      "@compass/*": ["./src/ui/compass/*"],
      "@features/*": ["./src/ui/features/*"],
      "@login/*": ["./src/ui/login/*"],

      "@command-palette/*": ["./src/ui/command-palette/*"],

      "@designer/*": ["./src/ui/designer/*"],
      "@developer/*": ["./src/ui/developer/*"],

      "@page-project/*": ["./src/ui/page-project/*"],
      "@page-projects/*": ["./src/ui/page-projects/*"],
      "@page-documentation/*": ["./src/ui/page-documentation/*"],
      "@page-access/*": ["./src/ui/page-access/*"],
      "@page-settings/*": ["./src/ui/page-settings/*"],
      "@page-system/*": ["./src/ui/page-system/*"],

      "@shared/*": ["./src/ui/shared/*"],
      "@panels/*": ["./src/ui/panels/*"],
      "@utils/*": ["./src/ui/utils/*"],
    }
  },
  "include": ["src", "**/*.ts", "**/*.tsx", "**/*.mjs"]
}
